<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Foto2PDF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Henüz fotoğraf eklenmedi."
            android:layout_marginBottom="12dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/thumbnailContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <Button
            android:id="@+id/takePhotoButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fotoğraf Çek"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/galleryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Galeriden Ekle"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/createPdfButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PDF Oluştur"
            android:enabled="false"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/clearButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fotoğrafları Temizle"
            android:layout_marginBottom="20dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PDF'i Paylaş"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/whatsappButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WhatsApp'a Gönder"
            android:enabled="false"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/telegramButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Telegram'a Gönder"
            android:enabled="false"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/shareButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Diğer Uygulamayla Paylaş"
            android:enabled="false" />

    </LinearLayout>
</ScrollView>
